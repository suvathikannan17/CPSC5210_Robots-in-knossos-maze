#!/bin/bash

# Require recipient before starting
if [ -z "$1" ]; then
    echo "Usage: ./buildTestSuite RECIPIENT_EMAIL"
    exit 1
fi

mkdir -p evidence

# Remove previous results to avoid reporting stale data
rm -f evidence/regression_results.xml
rm -f evidence/regression_results.txt

# Build the project
echo "Building project..."
cmake --build build-ninja
BUILD_STATUS=$?

# Run regression tests if build succeeds
if [ "$BUILD_STATUS" -eq 0 ]; then
    echo "Running regression tests..."

    ./build-ninja/bin/AllTests \
        --gtest_output=xml:evidence/regression_results.xml \
        > evidence/regression_results.txt 2>&1

    TEST_STATUS=$?

    cat evidence/regression_results.txt
else
    TEST_STATUS=1
fi

# Convert exit codes into readable results
if [ "$BUILD_STATUS" -eq 0 ]; then
    BUILD_SUCCESS="True"
else
    BUILD_SUCCESS="False"
fi

if [ "$TEST_STATUS" -eq 0 ]; then
    TESTS_PASSED="True"
else
    TESTS_PASSED="False"
fi

echo "-----------------------------"
echo "Build Successful: $BUILD_SUCCESS"
echo "Tests Passed: $TESTS_PASSED"
echo "-----------------------------"

# Send regression testing email
echo "Sending regression testing email..."

python3 send_regression_email.py \
    "$1" "$BUILD_SUCCESS" "$TESTS_PASSED"

EMAIL_STATUS=$?

if [ "$BUILD_STATUS" -ne 0 ] || \
   [ "$TEST_STATUS" -ne 0 ] || \
   [ "$EMAIL_STATUS" -ne 0 ]; then
    exit 1
fi

exit 0